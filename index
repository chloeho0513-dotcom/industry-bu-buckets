.tabs{display:flex;gap:6px;overflow-x:auto;padding:12px 0;margin-top:8px;position:sticky;top:env(safe-area-inset-top,0px);background:var(--bg);z-index:5;border-bottom:1px solid var(--line)}
.tab{white-space:nowrap;flex:none}.tab.on{background:var(--ink);color:var(--bg);border-color:var(--ink)}
.logic{display:flex;flex-direction:column;gap:6px;margin:0 0 14px}
