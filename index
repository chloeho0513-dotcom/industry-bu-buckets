body[data-f="rev"] .lever:not(.rev),body[data-f="cost"] .lever:not(.cost),body[data-f="bal"] .lever:not(.bal){opacity:.3}
.q{margin:14px 0 0;padding:10px 12px;border-radius:8px;background:var(--bg);font-size:.92rem}
