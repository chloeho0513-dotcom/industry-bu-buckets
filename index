<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"><title>Industry Issue Trees</title><style>:root{--bg:#f2f4f7;--card:#fff;--ink:#14202b;--muted:#5b6774;--line:#b9c2cc;--rev:#1a5fd0;--revbg:#e4eeff;--cost:#c4520f;--costbg:#fdeadb;--bal:#5e4b9a;--balbg:#ece7fa;--focus:#14202b;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0f151c;--card:#182029;--ink:#e8edf2;--muted:#9aa7b4;--line:#3b4753;--rev:#7fb0ff;--revbg:#15294d;--cost:#ffa566;--costbg:#40230f;--bal:#b8a6f5;--balbg:#2a2445;--focus:#e8edf2}}
:root[data-theme="dark"]{--bg:#0f151c;--card:#182029;--ink:#e8edf2;--muted:#9aa7b4;--line:#3b4753;--rev:#7fb0ff;--revbg:#15294d;--cost:#ffa566;--costbg:#40230f;--bal:#b8a6f5;--balbg:#2a2445;--focus:#e8edf2}
